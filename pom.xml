<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>org.juling.ecboot</groupId>
	<artifactId>ecboot-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<properties>
		<java.version>25</java.version>
		<!-- 分层依赖强制（FR-001～004/007/008）：槽位属性供各模块覆写（enforcer 的单个
		     exclude 不支持逗号分隔清单，实证 3.5.0），默认值不匹配任何构件；
		     禁止清单契约见 specs/001-maven-module-deps/contracts/module-contracts.md -->
		<enforcer.banned.1>org.juling.ecboot:__none__</enforcer.banned.1>
		<enforcer.banned.2>org.juling.ecboot:__none__</enforcer.banned.2>
		<enforcer.banned.3>org.juling.ecboot:__none__</enforcer.banned.3>
		<enforcer.banned.4>org.juling.ecboot:__none__</enforcer.banned.4>
		<enforcer.banned.5>org.juling.ecboot:__none__</enforcer.banned.5>
		<enforcer.allowed.1>org.juling.ecboot:__none__</enforcer.allowed.1>
	</properties>
	<modules>
		<module>dependencies</module>
		<module>infrastructure</module>
		<module>services</module>
		<module>apps</module>
		<module>start</module>
	</modules>
	<!-- 依赖/框架版本唯一仲裁点：ecboot-dependencies（就近优先，覆盖祖父级清单默认值） -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.juling.ecboot</groupId>
				<artifactId>ecboot-dependencies</artifactId>
				<version>${project.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<!-- 插件版本集中治理（澄清 Q3）：版本仅在 pluginManagement 声明，业务模块零插件版本 -->
	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.hibernate.orm</groupId>
					<artifactId>hibernate-maven-plugin</artifactId>
					<version>${hibernate.version}</version>
				</plugin>
				<plugin>
					<groupId>org.graalvm.buildtools</groupId>
					<artifactId>native-maven-plugin</artifactId>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-enforcer-plugin</artifactId>
					<executions>
						<execution>
							<id>enforce-layer-dependencies</id>
							<phase>validate</phase>
							<goals>
								<goal>enforce</goal>
							</goals>
							<configuration>
								<rules>
									<bannedDependencies>
										<excludes>
											<exclude>${enforcer.banned.1}</exclude>
											<exclude>${enforcer.banned.2}</exclude>
											<exclude>${enforcer.banned.3}</exclude>
											<exclude>${enforcer.banned.4}</exclude>
											<exclude>${enforcer.banned.5}</exclude>
										</excludes>
										<includes>
											<include>${enforcer.allowed.1}</include>
										</includes>
										<!-- 仅检查本 POM 声明的直接依赖：传递依赖属下游模块的契约责任，
										     否则合规的 apps→services 接线会在 start 的传递图中被误禁 -->
										<searchTransitive>false</searchTransitive>
										<message>违反分层依赖契约（start → apps → services → infrastructure）：见 specs/001-maven-module-deps/contracts/module-contracts.md</message>
									</bannedDependencies>
									<banDuplicatePomDependencyVersions/>
								</rules>
								<fail>true</fail>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-enforcer-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
								<path>
									<groupId>org.springframework.boot</groupId>
									<artifactId>spring-boot-configuration-processor</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.hibernate.orm</groupId>
				<artifactId>hibernate-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>enhance</id>
						<goals>
							<goal>enhance</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
