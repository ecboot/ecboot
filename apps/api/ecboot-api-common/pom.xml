<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.juling.ecboot</groupId>
		<artifactId>ecboot-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>ecboot-api-common</artifactId>
	<!-- 公共 API 渠道：对外提供短信、图形验证码等公共 REST API；
	     与 user/shop/admin 同级渠道——四渠道互不编译依赖；禁依赖全部领域服务 -->
	<properties>
		<enforcer.banned.1>org.juling.ecboot:ecboot-service-user</enforcer.banned.1>
		<enforcer.banned.2>org.juling.ecboot:ecboot-service-shop</enforcer.banned.2>
		<enforcer.banned.3>org.juling.ecboot:ecboot-api-user</enforcer.banned.3>
		<enforcer.banned.4>org.juling.ecboot:ecboot-api-shop</enforcer.banned.4>
		<enforcer.banned.5>org.juling.ecboot:ecboot-api-admin</enforcer.banned.5>
		<enforcer.banned.6>org.juling.ecboot:ecboot-start</enforcer.banned.6>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.juling.ecboot</groupId>
			<artifactId>ecboot-api-webmvc</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.juling.ecboot</groupId>
			<artifactId>ecboot-common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.juling.ecboot</groupId>
			<artifactId>ecboot-infra-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
