<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.juling.ecboot</groupId>
		<artifactId>ecboot-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>ecboot-common</artifactId>
	<!-- 分层禁令（enforcer 仅精确 GA 匹配，组级通配实测无效）：禁令 = 内部构件全集 − 白名单{无}；矩阵见 specs/001-maven-module-deps/contracts/module-contracts.md -->
	<properties>
		<enforcer.banned.1>org.juling.ecboot:ecboot-infra-core</enforcer.banned.1>
		<enforcer.banned.2>org.juling.ecboot:ecboot-service-user</enforcer.banned.2>
		<enforcer.banned.3>org.juling.ecboot:ecboot-service-shop</enforcer.banned.3>
		<enforcer.banned.4>org.juling.ecboot:ecboot-api-common</enforcer.banned.4>
		<enforcer.banned.5>org.juling.ecboot:ecboot-api-user</enforcer.banned.5>
		<enforcer.banned.6>org.juling.ecboot:ecboot-api-shop</enforcer.banned.6>
		<enforcer.banned.7>org.juling.ecboot:ecboot-api-admin</enforcer.banned.7>
		<enforcer.banned.8>org.juling.ecboot:ecboot-api-webmvc</enforcer.banned.8>
		<enforcer.banned.9>org.juling.ecboot:ecboot-start</enforcer.banned.9>
	</properties>
	<dependencies>
		<!-- 通用 DTO/响应对象最小闭集，不引任何运行时容器 -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-annotations</artifactId>
		</dependency>
		<dependency>
			<groupId>jakarta.validation</groupId>
			<artifactId>jakarta.validation-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
</project>
