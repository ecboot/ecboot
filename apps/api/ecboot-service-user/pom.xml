<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.juling.ecboot</groupId>
		<artifactId>ecboot-parent</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<artifactId>ecboot-service-user</artifactId>
	<!-- 分层禁令（enforcer 仅精确 GA 匹配，组级通配实测无效）：禁令 = 内部构件全集 − 白名单{ecboot-common、ecboot-infra-core}；矩阵见 specs/001-maven-module-deps/contracts/module-contracts.md -->
	<properties>
		<enforcer.banned.1>org.juling.ecboot:ecboot-service-shop</enforcer.banned.1>
		<enforcer.banned.2>org.juling.ecboot:ecboot-api-common</enforcer.banned.2>
		<enforcer.banned.3>org.juling.ecboot:ecboot-api-user</enforcer.banned.3>
		<enforcer.banned.4>org.juling.ecboot:ecboot-api-shop</enforcer.banned.4>
		<enforcer.banned.5>org.juling.ecboot:ecboot-api-admin</enforcer.banned.5>
		<enforcer.banned.6>org.juling.ecboot:ecboot-api-webmvc</enforcer.banned.6>
		<enforcer.banned.7>org.juling.ecboot:ecboot-start</enforcer.banned.7>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.juling.ecboot</groupId>
			<artifactId>ecboot-common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.juling.ecboot</groupId>
			<artifactId>ecboot-infra-core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<!-- 领域层=实体+仓储+事务；驱动由装配层统一提供 -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
